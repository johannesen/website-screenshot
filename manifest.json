{
  "manifest_version": 3,
  "name": "Website Screenshot Capture",
  "version": "2.0.0",
  "description": "The ultimate website screenshot tool: visible area, crop, full page, DOM element picker, delay timer, OCR, and full vector editor.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "capture-visible": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Capture visible viewport"
    },
    "capture-crop": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Capture selected area"
    },
    "capture-fullpage": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Capture full page"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
